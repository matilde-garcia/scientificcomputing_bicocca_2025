Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "==", "0"}], ",", " ", "x"}], "]"}], 
  " "}]], "Input",
 CellChangeTimes->{{3.972971395209372*^9, 3.9729714363003407`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"524d96fd-0f25-4a26-9c4d-8f2ff22e17ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "\[Equal]", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"3", "+", 
     RowBox[{"ProductLog", "[", 
      RowBox[{"-", 
       FractionBox["4", 
        SuperscriptBox["\[ExponentialE]", "3"]]}], "]"}]}]]}], "||", 
  RowBox[{"x", "\[Equal]", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"3", "+", 
     RowBox[{"ProductLog", "[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", 
        FractionBox["4", 
         SuperscriptBox["\[ExponentialE]", "3"]]}]}], "]"}]}]]}]}]], "Output",
 CellChangeTimes->{{3.972971430339943*^9, 3.9729714369011106`*^9}},
 CellLabel->"Out[11]=",ExpressionUUID->"b6c2d42c-036f-4004-ba93-72661959e68a"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Q4: Solve the following initial-value problem using both DSolve \
and NDSolve. Compare your answers by plotting them.\ny\[CloseCurlyQuote]\
\[CloseCurlyQuote](x) - x y(x) = 0\ny(0) = 1\ny\[CloseCurlyQuote](0) = - ",
  FontSize->20],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["3", 
     RowBox[{"1", "/", "3"}]], 
    RowBox[{
     RowBox[{"Gamma", "(", 
      RowBox[{"2", "/", "3"}], ")"}], "/", 
     RowBox[{"Gamma", "(", 
      RowBox[{"1", "/", "3"}], ")"}]}]}], TraditionalForm]],
  FontSize->20,ExpressionUUID->"ac850641-00d1-484e-9415-15ee610f4d3c"],
 StyleBox["\n(bonus: solve it with scipy and check result and speed).  ",
  FontSize->20],
 "\n"
}], "Text",
 CellChangeTimes->{
  3.972974162465692*^9},ExpressionUUID->"9031b7d0-d7bd-448a-8996-\
f9594fae20c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "''"}], "[", "x", "]"}], " ", "-", " ", 
       RowBox[{"x", " ", 
        RowBox[{"y", "[", "x", "]"}]}]}], "==", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "==", "1"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "0", "]"}], "==", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["3", 
         RowBox[{"1", "/", "3"}]]}], 
       RowBox[{"Gamma", "[", 
        RowBox[{"2", "/", "3"}], "]"}], 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "/", "3"}], "]"}]}]}]}], "}"}], ",", " ", 
   RowBox[{"y", "[", "x", "]"}], ",", " ", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.972974206357676*^9, 3.9729742108775516`*^9}, {
  3.9729742664454823`*^9, 3.9729743583184447`*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"2fd17b6e-5bcc-404f-8ef1-50dd9692f9f7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"2", "/", "3"}]], " ", 
        RowBox[{"AiryAi", "[", "x", "]"}], " ", 
        RowBox[{"Gamma", "[", 
         FractionBox["2", "3"], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"1", "/", "6"}]], " ", 
        RowBox[{"AiryBi", "[", "x", "]"}], " ", 
        RowBox[{"Gamma", "[", 
         FractionBox["2", "3"], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"2", "/", "3"}]], " ", 
        RowBox[{"AiryAi", "[", "x", "]"}], " ", 
        SuperscriptBox[
         RowBox[{"Gamma", "[", 
          FractionBox["1", "3"], "]"}], "2"], " ", 
        RowBox[{"Gamma", "[", 
         FractionBox["2", "3"], "]"}]}], "-", 
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"1", "/", "6"}]], " ", 
        RowBox[{"AiryBi", "[", "x", "]"}], " ", 
        SuperscriptBox[
         RowBox[{"Gamma", "[", 
          FractionBox["1", "3"], "]"}], "2"], " ", 
        RowBox[{"Gamma", "[", 
         FractionBox["2", "3"], "]"}]}]}], ")"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.9729743472039833`*^9, 3.9729743614319944`*^9}, 
   3.9729744882081966`*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"5db6382a-5081-4b41-bb42-08eb5b4ee155"]
}, Open  ]],

