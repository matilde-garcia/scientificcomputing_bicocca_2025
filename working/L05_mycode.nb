Cell[TextData[StyleBox["Q3: Solve the equation  x ln(x) - 3 x + 10 = 6, both \
symbolically and numerically.",
 FontSize->20]], "Text",
 CellChangeTimes->{
  3.9729681492320642`*^9, {3.972968235914739*^9, 
   3.9729682571192923`*^9}},ExpressionUUID->"53b00a50-2fa3-4ec3-8b29-\
f647d879fb3f"],

