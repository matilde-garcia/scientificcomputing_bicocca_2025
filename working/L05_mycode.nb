Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "==", "0"}], ",", " ", "x"}], "]"}], 
  " "}]], "Input",
 CellChangeTimes->{{3.972971395209372*^9, 3.9729714363003407`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"524d96fd-0f25-4a26-9c4d-8f2ff22e17ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "\[Equal]", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"3", "+", 
     RowBox[{"ProductLog", "[", 
      RowBox[{"-", 
       FractionBox["4", 
        SuperscriptBox["\[ExponentialE]", "3"]]}], "]"}]}]]}], "||", 
  RowBox[{"x", "\[Equal]", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"3", "+", 
     RowBox[{"ProductLog", "[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", 
        FractionBox["4", 
         SuperscriptBox["\[ExponentialE]", "3"]]}]}], "]"}]}]]}]}]], "Output",
 CellChangeTimes->{{3.972971430339943*^9, 3.9729714369011106`*^9}},
 CellLabel->"Out[11]=",ExpressionUUID->"b6c2d42c-036f-4004-ba93-72661959e68a"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Q4: Solve the following initial-value problem using both DSolve \
and NDSolve. Compare your answers by plotting them.\ny\[CloseCurlyQuote]\
\[CloseCurlyQuote](x) - x y(x) = 0\ny(0) = 1\ny\[CloseCurlyQuote](0) = - ",
  FontSize->20],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["3", 
     RowBox[{"1", "/", "3"}]], 
    RowBox[{
     RowBox[{"Gamma", "(", 
      RowBox[{"2", "/", "3"}], ")"}], "/", 
     RowBox[{"Gamma", "(", 
      RowBox[{"1", "/", "3"}], ")"}]}]}], TraditionalForm]],
  FontSize->20,ExpressionUUID->"ac850641-00d1-484e-9415-15ee610f4d3c"],
 StyleBox["\n(bonus: solve it with scipy and check result and speed).  ",
  FontSize->20],
 "\n"
}], "Text",
 CellChangeTimes->{
  3.972974162465692*^9},ExpressionUUID->"9031b7d0-d7bd-448a-8996-\
f9594fae20c9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sol1", " ", "=", " ", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "''"}], "[", "x", "]"}], " ", "-", " ", 
        RowBox[{"x", " ", 
         RowBox[{"y", "[", "x", "]"}]}]}], "==", "0"}], ",", " ", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "1"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "0", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["3", 
          RowBox[{"1", "/", "3"}]]}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"2", "/", "3"}], "]"}], 
        RowBox[{"Gamma", "[", 
         RowBox[{"1", "/", "3"}], "]"}]}]}]}], "}"}], ",", " ", 
    RowBox[{"y", "[", "x", "]"}], ",", " ", "x", ",", " ", 
    RowBox[{"Assumptions", " ", "->", " ", 
     RowBox[{"x", ">=", "0"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.972974206357676*^9, 3.9729742108775516`*^9}, {
  3.9729742664454823`*^9, 3.9729743583184447`*^9}, {3.9729807336781273`*^9, 
  3.9729807371673183`*^9}, {3.97298101754812*^9, 3.972981029569458*^9}, {
  3.972981103656492*^9, 3.9729811396797686`*^9}, {3.972981193488929*^9, 
  3.9729812022295628`*^9}, {3.972981355210188*^9, 3.9729813716032047`*^9}, {
  3.9729815186029367`*^9, 3.9729815204415045`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"2fd17b6e-5bcc-404f-8ef1-50dd9692f9f7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"2", "/", "3"}]], " ", 
        RowBox[{"AiryAi", "[", "x", "]"}], " ", 
        RowBox[{"Gamma", "[", 
         FractionBox["2", "3"], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"1", "/", "6"}]], " ", 
        RowBox[{"AiryBi", "[", "x", "]"}], " ", 
        RowBox[{"Gamma", "[", 
         FractionBox["2", "3"], "]"}]}], "+", 
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"2", "/", "3"}]], " ", 
        RowBox[{"AiryAi", "[", "x", "]"}], " ", 
        SuperscriptBox[
         RowBox[{"Gamma", "[", 
          FractionBox["1", "3"], "]"}], "2"], " ", 
        RowBox[{"Gamma", "[", 
         FractionBox["2", "3"], "]"}]}], "-", 
       RowBox[{
        SuperscriptBox["3", 
         RowBox[{"1", "/", "6"}]], " ", 
        RowBox[{"AiryBi", "[", "x", "]"}], " ", 
        SuperscriptBox[
         RowBox[{"Gamma", "[", 
          FractionBox["1", "3"], "]"}], "2"], " ", 
        RowBox[{"Gamma", "[", 
         FractionBox["2", "3"], "]"}]}]}], ")"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.972981203090903*^9, 3.9729812352452335`*^9, 3.9729813243827977`*^9, {
   3.972981358350787*^9, 3.9729813744296036`*^9}, 3.972981521391384*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"43682a32-52e5-43dd-85fd-5bc087e3f347"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "/.", 
    RowBox[{"{", "Sol1", "}"}]}], ",", " ", 
