Cell["\<\
The first three roots should be between 0 and 10 (assuming 0 also counts)\
\>", "Text",
 CellChangeTimes->{
  3.9729739469383607`*^9},ExpressionUUID->"591c06f3-37f7-4355-bc98-\
1e1ad9a1281c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"BesselJ", "[", 
     RowBox[{"1", ",", "x"}], "]"}], "==", "0"}], " ", "&&", " ", 
   RowBox[{"0", " ", "<=", "x", "<=", "10"}]}], "]"}]], "Input",
