  3.972971244069227*^9}, {3.9729714695355415`*^9, 3.9729714696159687`*^9}, {
  3.9729740977926636`*^9, 
  3.9729740989018774`*^9}},ExpressionUUID->"dda8e20b-d32e-4f4e-a2c5-\
24bd50dd0322"],

